{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶️ 1. Ejecutar Práctica Pandas (Ejercicios 1 al 6)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/practica_pandas.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "🌐 2. Iniciar Dashboard Web Flask (Cyberpunk)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONIOENCODING": "utf-8",
                "FLASK_ENV": "development"
            }
        },
        {
            "name": "⚡ 3. Regenerar Dataset CSV (calificaciones_isc.csv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/generate_dataset.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
